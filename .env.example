# Public address of the site, no trailing slash. Enables sitemap.xml, the robots.txt sitemap line,
# canonical links and absolute social-share URLs. Leave empty to skip them.
SITE_URL=

# Base URL of the admin panel's content API, no trailing slash. Empty = render the bundled content/ folder (demo mode).
CMS_API_URL=

# Optional bearer token if the content API is private.
CMS_API_TOKEN=

# Seconds a fetched page stays fresh before it is regenerated in the background (safety net; the webhook is instant).
CMS_REVALIDATE_SECONDS=60

# Shared secret for POST /api/revalidate (send it in the x-revalidate-secret header).
CMS_REVALIDATE_SECRET=
